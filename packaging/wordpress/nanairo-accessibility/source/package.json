{
  "name": "@nanairo/accessibility",
  "version": "0.1.0",
  "description": "A lightweight Japanese and English accessibility preference widget.",
  "type": "module",
  "license": "GPL-2.0-or-later",
  "main": "./dist/nanairo-accessibility.iife.js",
  "module": "./dist/nanairo-accessibility.es.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/nanairo-accessibility.es.js",
      "default": "./dist/nanairo-accessibility.iife.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && tsc -p tsconfig.build.json",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "lit": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^5.0.1"
  }
}
